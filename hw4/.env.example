# Copy this file to .env (in this folder) and replace the placeholder.
# Never commit your real .env.

# Required: Portkey API key used to reach the model
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides
# AGENT_MODEL=gpt-5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_VIRTUAL_KEY=your-portkey-virtual-key
# COOKIE_SECURE=1          # set when serving over HTTPS
# AUDIT_TRAIL_PATH=output/audit_trail.json
